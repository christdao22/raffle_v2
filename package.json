{
  "name": "raffle_v2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @raffle_v2/db db:generate",
    "db:push": "pnpm --filter @raffle_v2/db db:push",
    "db:studio": "pnpm --filter @raffle_v2/db db:studio",
    "auth:generate": "pnpm --filter @raffle_v2/api auth:generate",
    "seed": "pnpm --filter @raffle_v2/api seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  }
}

