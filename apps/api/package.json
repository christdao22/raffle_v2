{
  "name": "@raffle_v2/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/lib/auth.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "auth:generate": "npx @better-auth/cli generate --config src/lib/auth.ts --output ../../packages/db/src/schema/auth.ts -y",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@hono/zod-openapi": "^1.5.1",
    "@raffle_v2/db": "workspace:*",
    "@raffle_v2/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.11",
    "better-auth": "^1.6.25",
    "dotenv": "^16.6.1",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "zod": "^4.4.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@raffle_v2/typescript-config": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
